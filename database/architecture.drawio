<mxfile host="app.diagrams.net" agent="seatrade-ai" version="24.7.0" type="device"><diagram id="seatrade-architecture" name="SeaTrade AI Architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="1300" math="0" shadow="0" background="#12121e"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n101" value="SeaTrade AI — Sơ đồ Kiến trúc Hệ thống" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="16" width="900" height="40" as="geometry"/></mxCell><mxCell id="n102" value="" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeColor=#546E7A;fillColor=none;fontColor=#546E7A;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;fontSize=14;fontStyle=1;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1560" height="980" as="geometry"/></mxCell><mxCell id="n103" value="Client Applications" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeColor=#4DD0E1;fillColor=none;fontColor=#4DD0E1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;fontSize=14;fontStyle=1;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="70" y="120" width="340" height="270" as="geometry"/></mxCell><mxCell id="n104" value="Web Admin
