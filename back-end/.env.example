# Copy file này thành ".env" (cùng thư mục back-end/) rồi điền thông tin
# thật của máy bạn. KHÔNG commit file ".env" thật lên git (đã có trong
# .gitignore của repo — chỉ .env.example được phép commit).

PORT=5000

# Chuỗi kết nối PostgreSQL, định dạng:
#   postgres://<user>:<password>@<host>:<port>/<ten_database>
# - user/password: tài khoản Postgres bạn dùng (mặc định là "postgres" +
#   mật khẩu bạn đặt lúc cài PostgreSQL/pgAdmin).
# - ten_database: seafood_trading — đặt theo đúng tên đồng đội dùng trong
#   dòng comment "CREATE DATABASE Seafood_trading;" ở đầu
#   database/full_schema_dongdoi.sql (Postgres tự chuyển thành chữ thường).
# Lưu ý: nếu mật khẩu có ký tự đặc biệt (@ : / % ...), phải URL-encode lại,
# ví dụ mật khẩu "a@b" -> "a%40b".
DATABASE_URL=postgres://postgres:abc@localhost:5432/seafood_trading

# Có thể để mặc định khi chạy local, hoặc đổi sang chuỗi bí mật riêng.
JWT_SECRET=super_secret_jwt_key_cho_seatrade_2026

# Khoá Claude API cho Trợ lý AI của web admin (tạo tại https://console.anthropic.com).
# Bỏ trống thì các chức năng khác vẫn chạy, riêng Trợ lý AI báo chưa cấu hình.
ANTHROPIC_API_KEY=

# true = Trợ lý AI chạy chế độ giả lập (không gọi Claude, không tốn phí, vẫn dùng
# dữ liệu thật trong DB). Đặt false khi đã có ANTHROPIC_API_KEY.
AI_AGENT_MOCK=true
