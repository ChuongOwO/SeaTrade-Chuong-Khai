# 1. Chặn toàn bộ bên ngoài thư mục gốc
/*

# 2. Ngoại trừ các thư mục source code
!/ai-service/
!/back-end/
!/mobile/
!/test/
!/web/

# 3. Ngoại trừ các file tài liệu và cấu hình gốc
!/README.md
!/HUONG_DAN_SU_DUNG.md
!/.gitignore

# ---------------------------------------------
# Common / Shared ignores (áp dụng cho toàn dự án)
# ---------------------------------------------
node_modules/
dist/
build/
web-build/
.env*
!.env.example
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
*.tsbuildinfo

# Lockfile của package manager khác pnpm — project này chuẩn hóa dùng pnpm
# (đã có sẵn pnpm-lock.yaml). Tránh commit lockfile song song gây lệch
# phiên bản dependency giữa các máy trong nhóm.
package-lock.json
yarn.lock

# ---------------------------------------------
# Mobile & Expo specifics
# ---------------------------------------------
.expo/
expo-env.d.ts
.metro-health-check*

# Native build artifacts & keys
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
/mobile/ios/
/mobile/android/
